# Copie este arquivo para .env.local e preencha. Nunca faça commit do .env.local.

# Chave da API do Claude (https://console.anthropic.com/) — usada pelo copiloto.
ANTHROPIC_API_KEY=

# Modelo do copiloto (opcional).
CLAUDE_CHAT_MODEL=claude-sonnet-5-5

# Opcional. Token gratuito da brapi.dev: reserva caso o Yahoo Finance falhe.
BRAPI_TOKEN=

# Caminho do banco SQLite local (opcional).
DATABASE_PATH=data/app.db
